# Configuración de Langfuse para el docker-compose.yml oficial.
# No edites este fichero: ejecuta ./generate_env.sh, que crea .env con secretos aleatorios.
# Si lo rellenas a mano, no pongas comillas en los valores LANGFUSE_INIT_* (lo indica la documentación).

# URL pública de la interfaz. En el servidor, cambia localhost por la IP o el nombre del servidor.
NEXTAUTH_URL=http://localhost:3000
TELEMETRY_ENABLED=false

# Secretos (CHANGEME en el compose oficial)
NEXTAUTH_SECRET=
SALT=
ENCRYPTION_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://postgres:<POSTGRES_PASSWORD>@postgres:5432/postgres
CLICKHOUSE_PASSWORD=
REDIS_AUTH=
MINIO_ROOT_PASSWORD=
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>
LANGFUSE_S3_BATCH_EXPORT_SECRET_ACCESS_KEY=<MINIO_ROOT_PASSWORD>

# Inicialización automática: organización, proyecto compartido, claves y usuario administrador.
LANGFUSE_INIT_ORG_ID=iab4
LANGFUSE_INIT_ORG_NAME=IAB4
LANGFUSE_INIT_PROJECT_ID=rag-semana2
LANGFUSE_INIT_PROJECT_NAME=RAG semana 2
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=
