# Copia este fichero a .env y rellena las claves. .env no se sube al repositorio.

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
GEN_MODEL=google/gemini-3.1-flash-lite
JUDGE_MODEL=openai/gpt-5-mini
VLM_MODEL=google/gemini-3.1-flash-lite

# Langfuse local: las rellena servidor/langfuse/generate_env.sh. Si se dejan vacías, las trazas van a trazas/trazas.jsonl.
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Tu nombre: se guarda como User ID en cada traza
ALUMNO=

# Qdrant (notebook 3, sección 9): docker compose up -d en servidor/qdrant
QDRANT_URL=http://localhost:6333

# Servicio opcional de ColPali en el servidor (casa_04 y notebook 7)
COLPALI_URL=

# 1 = datos reducidos para clase; 0 = todo
FAST_MODE=1
# Fuerza CPU aunque haya GPU (1 = sí)
FORCE_CPU=0
